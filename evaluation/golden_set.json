    "category": "Traversal",
    "difficulty": "hard",
    "question": "What is the characteristic resistance in positive local X direction for MT-C-GS OC when using the channel MT-40D V2 and the channel connector MT-FL?",
    "reference_cypher_query": "MATCH (c:Connector {designation: 'MT-C-GS OC'})-[:HAS_RESISTANCE_CONFIGURATION]->(rc:ResistanceConfiguration) MATCH (rc)-[:USES_CHANNEL]->(ch:Channel {designation: 'MT-40D V2'}) MATCH (rc)-[:USES_CHANNEL_CONNECTOR]->(cc:Connector {designation: 'MT-FL'}) RETURN rc.fx_positive",
    "expected_result": [[14.93]],
    "expected_answer_content": {
      "fx_positive": 14.93,
      "unit": "kN"
    }
  },
